# Resend API Key (from https://resend.com/api-keys)
# Keep this strictly private and never expose it to the browser (never use NEXT_PUBLIC_)
RESEND_API_KEY=re_your_api_key_here

# Recipient Email Address (your personal or business Gmail address where contact messages will be delivered)
CONTACT_EMAIL=yourname@gmail.com

# Verified Sender Address (must be a verified domain in Resend, or onboarding@resend.dev for initial testing)
# Note: onboarding@resend.dev can only send to the email address registered on your Resend account.
CONTACT_FROM_EMAIL=Portfolio Contact <contact@yourdomain.com>
